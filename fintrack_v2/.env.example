# Supabase Local Development Environment Variables
# Copy this file to .env.local and update values if needed.

# For Local Supabase (Default output from `supabase start` or `npx supabase status`):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here


# Supabase Cloud Configuration
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-cloud-anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<your-cloud-service-role-key-optional>